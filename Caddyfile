{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}

# Explicit HTTP -> HTTPS redirect
http://{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

http://{$API_DOMAIN} {
	redir https://{$API_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy frontend:80
}

{$API_DOMAIN} {
	import security_headers
	encode zstd gzip

	# CORS preflight handled by Caddy (NestJS won't see OPTIONS due to respond)
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Origin "https://{$APP_DOMAIN}"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

	# Non-preflight: let NestJS handle CORS headers (no duplicates)
	reverse_proxy backend:3000
}
