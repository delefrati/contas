{
	email {$ACME_EMAIL}

	# Each band lives on its own subdomain (<slug>.{$BASE_DOMAIN}). Certificates are
	# issued on first visit, and only for slugs that exist in the bands table.
	on_demand_tls {
		ask http://backend:3000/api/band/tls-check
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}

(app) {
	import security_headers
	encode zstd gzip

	# API is served on the same host as the app, so no CORS is needed
	handle /api/* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Central login (the only origin registered with Google); hands off to the band's subdomain
{$BASE_DOMAIN} {
	import app
}

www.{$BASE_DOMAIN} {
	redir https://{$BASE_DOMAIN}{uri} permanent
}

*.{$BASE_DOMAIN} {
	tls {
		on_demand
	}

	import app
}
