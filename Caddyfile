{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}

(app) {
	import security_headers
	encode zstd gzip

	# API is served on the same host as the app, so no CORS is needed
	handle /api/* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Central login (the only origin registered with Google); hands off to the band's subdomain
{$BASE_DOMAIN} {
	import app
}

www.{$BASE_DOMAIN} {
	redir https://{$BASE_DOMAIN}{uri} permanent
}

# Each band lives on its own subdomain (<slug>.{$BASE_DOMAIN}), all covered by one
# wildcard certificate. The app sends addresses without a band to the central host.
*.{$BASE_DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	import app
}
