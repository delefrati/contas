APP_ENV=production

MYSQL_DATABASE=contas
MYSQL_USER=contas
MYSQL_PASSWORD=CHANGE_ME_DB_USER_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

# At least 32 characters, never an example value, or the backend won't start: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Optional: Spotify playlists (DEPLOY-OCI.md, section 8). Leave empty to keep them off.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://minhabanda.com/api/admin/spotify/callback
# openssl rand -base64 32
SPOTIFY_TOKEN_KEY=

# Each band is served at <slug>.BASE_DOMAIN (e.g. maverick.minhabanda.com)
BASE_DOMAIN=minhabanda.com
ACME_EMAIL=you@yourdomain.com
# Cloudflare API token limited to the BASE_DOMAIN zone (Zone: Read, DNS: Edit), used by
# Caddy to issue the wildcard certificate. Also needed in the server's .env.
CF_API_TOKEN=your_cloudflare_api_token

# Deployment (used by scripts/sync-from-prod.sh)
DEPLOY_SSH_KEY=/path/to/your/ssh-key.key
DEPLOY_SSH_HOST=user@your-server-ip
DEPLOY_REMOTE_DIR=~/contas-app
