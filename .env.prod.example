APP_ENV=production

MYSQL_DATABASE=contas
MYSQL_USER=contas
MYSQL_PASSWORD=CHANGE_ME_DB_USER_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Each band is served at <slug>.BASE_DOMAIN (e.g. maverick.minhabanda.com)
BASE_DOMAIN=minhabanda.com
ACME_EMAIL=you@yourdomain.com

# Deployment (used by scripts/sync-from-prod.sh)
DEPLOY_SSH_KEY=/path/to/your/ssh-key.key
DEPLOY_SSH_HOST=user@your-server-ip
DEPLOY_REMOTE_DIR=~/contas-app
