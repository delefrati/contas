// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Band {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(63)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  // Uploaded by the band (PNG, JPEG or WebP); logoUpdatedAt versions its URL for caching
  logo          Bytes?    @db.MediumBlob
  logoType      String?   @map("logo_type") @db.VarChar(20)
  logoUpdatedAt DateTime? @map("logo_updated_at")

  members      Member[]
  expenseTypes ExpenseType[]
  expenses     Expense[]
  songs        Song[]
  eventTypes   EventType[]
  events       Event[]
  logs         Log[]

  @@map("bands")
}

model Member {
  id      Int     @id @default(autoincrement())
  bandId  Int     @map("band_id")
  name    String  @db.VarChar(255)
  email   String? @db.VarChar(255)
  oidcSub String? @map("oidc_sub") @db.VarChar(255)
  active  Boolean @default(true)

  band           Band            @relation(fields: [bandId], references: [id])
  expenseMembers ExpenseMember[]
  sessions       Session[]
  logs           Log[]

  @@unique([bandId, email])
  @@unique([bandId, oidcSub])
  @@map("members")
}

// Manages the platform: not a member of any band, but may sign in to all of them
model SuperAdmin {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  sessions Session[]
  logs     Log[]

  @@map("super_admins")
}

model ExpenseType {
  id        Int       @id @default(autoincrement())
  bandId    Int       @map("band_id")
  name      String    @db.VarChar(255)
  deletedAt DateTime? @map("deleted_at")

  band     Band      @relation(fields: [bandId], references: [id])
  expenses Expense[]

  @@index([bandId])
  @@map("expense_types")
}

model Expense {
  id          Int       @id @default(autoincrement())
  bandId      Int       @map("band_id")
  description String    @db.VarChar(255)
  amount      Decimal   @db.Decimal(12, 2)
  fkType      Int?      @map("fk_type")
  fkMember    Int?      @map("fk_member")
  date        String    @default("") @db.VarChar(10)
  paid        Boolean   @default(false)
  createdAt   String    @map("created_at") @db.VarChar(40)
  deletedAt   DateTime? @map("deleted_at")

  band Band         @relation(fields: [bandId], references: [id])
  type ExpenseType? @relation(fields: [fkType], references: [id])

  members ExpenseMember[]

  @@index([bandId])
  @@map("expenses")
}

model ExpenseMember {
  expenseId Int @map("expense_id")
  memberId  Int @map("member_id")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([expenseId, memberId])
  @@map("expense_members")
}

model Log {
  id         Int      @id @default(autoincrement())
  bandId     Int      @map("band_id")
  action     String   @db.VarChar(50)
  resource   String   @db.VarChar(100)
  resourceId Int?     @map("resource_id")
  details    String?  @db.LongText
  createdAt    DateTime @default(now()) @map("created_at")
  userId       Int?     @map("user_id")
  superAdminId Int?     @map("super_admin_id")

  band       Band        @relation(fields: [bandId], references: [id])
  user       Member?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  superAdmin SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@index([bandId])
  @@index([superAdminId])
  @@map("logs")
}

// Belongs to either a band member or a super admin
model Session {
  id           Int      @id @default(autoincrement())
  memberId     Int?     @map("member_id")
  superAdminId Int?     @map("super_admin_id")
  token        String   @unique @db.VarChar(500)
  oidcSub      String?  @map("oidc_sub") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  member     Member?     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  superAdmin SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([superAdminId])
  @@index([expiresAt])
  @@index([oidcSub])
  @@map("sessions")
}

model Song {
  id        Int       @id @default(autoincrement())
  bandId    Int       @map("band_id")
  title     String    @db.VarChar(255)
  artist    String?   @db.VarChar(255)
  notes     String?   @db.Text
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  band        Band             @relation(fields: [bandId], references: [id])
  events      EventSong[]

  @@index([bandId])
  @@map("songs")
}

model EventType {
  id        Int       @id @default(autoincrement())
  bandId    Int       @map("band_id")
  name      String    @db.VarChar(255)
  color     String    @default("#667eea") @db.VarChar(7)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  band   Band    @relation(fields: [bandId], references: [id])
  events Event[]

  @@index([bandId])
  @@map("event_types")
}

model Event {
  id        Int       @id @default(autoincrement())
  bandId    Int       @map("band_id")
  typeId    Int       @map("type_id")
  title     String    @default("") @db.VarChar(255)
  date      String    @db.VarChar(10)
  time      String    @default("") @db.VarChar(5)
  location  String?   @db.VarChar(255)
  notes     String?   @db.Text
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  band    Band        @relation(fields: [bandId], references: [id])
  type    EventType   @relation(fields: [typeId], references: [id])
  setlist EventSong[]

  @@index([bandId, date])
  @@index([typeId])
  @@map("events")
}

model EventSong {
  id       Int     @id @default(autoincrement())
  eventId  Int     @map("event_id")
  songId   Int?    @map("song_id")
  type     String  @default("song") @db.VarChar(20)
  label    String? @db.VarChar(255)
  position Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  song  Song? @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([songId])
  @@map("event_songs")
}
